# --- Acceso ---
# Contraseña compartida para entrar a la aplicación (obligatoria en Railway)
APP_PASSWORD=
# Opcional: texto largo al azar para firmar las sesiones
SESSION_SECRET=
# Railway define PORT solo; en local puedes dejar 3000
PORT=3000

# --- Supabase (si lo dejas vacío, guarda en la carpeta DATA_DIR) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=assets
DATA_DIR=data

# --- Google Drive ---
# ID de la carpeta de proyectos; solo se puede ver su contenido
DRIVE_ROOT_FOLDER_ID=
# Local: archivo credentials.json / token.json. En Railway usa GOOGLE_CREDENTIALS_JSON
GOOGLE_CREDENTIALS=token.json
# Contenido JSON del archivo (en una sola línea) para Railway
GOOGLE_CREDENTIALS_JSON=
INCLUIR_DOCX=false
